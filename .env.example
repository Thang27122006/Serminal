# ==============================================================================
# AI MEETING - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và cấu hình giá trị phù hợp cho môi trường của bạn.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env THỰC TẾ LÊN HỆ THỐNG QUẢN LÝ MÃ NGUỒN (GIT).
# ==============================================================================

# Cấu hình Django chung
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Cơ sở dữ liệu (PostgreSQL)
# Đặt DB_ENGINE=sqlite3 để phát triển nhanh trên máy tính chưa cài đặt PostgreSQL
DB_ENGINE=postgresql
DB_NAME=ai_meeting_db
DB_USER=ai_meeting_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Message Broker (Redis) cho Django Channels
# Nếu USE_REDIS=False, hệ thống sẽ sử dụng InMemoryChannelLayer phục vụ phát triển cục bộ
USE_REDIS=False
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://127.0.0.1:6379/0

# Cấu hình CORS (Cross-Origin Resource Sharing)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cấu hình WebRTC STUN/TURN (dành cho client/signaling sau này)
STUN_SERVER_URL=stun:stun.l.google.com:19302
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=turn_user
# TURN_CREDENTIAL=turn_password
